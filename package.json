{
  "name": "emdash-document-revisions-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "typecheck": "pnpm --filter emdash-document-revisions typecheck && tsc -p tests && tsc -p tests/unit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:import": "vitest run --project import"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^22.20.4",
    "cheerio": "^1.2.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
