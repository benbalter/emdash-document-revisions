{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media",
		},
		// Private document files. Must NOT be the media bucket: core serves
		// every media-bucket key publicly via /_emdash/api/media/file/:key.
		{
			"binding": "DOCUMENTS",
			"bucket_name": "my-emdash-documents",
		},
	],
	// Document processing (emdash-document-revisions): uploads enqueue a
	// job; the Worker's queue handler extracts text.
	"queues": {
		"producers": [{ "binding": "DOC_JOBS", "queue": "document-jobs" }],
		"consumers": [{ "queue": "document-jobs", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3 }],
	},
	// Throttles password attempts on protected documents.
	"ratelimits": [{ "name": "DOC_PASSWORD_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
